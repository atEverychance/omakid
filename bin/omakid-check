#!/usr/bin/env bash
# Drift report, not a security gate.
set -u
ok() { printf '  \033[32m✓\033[0m %s\n' "$1"; }
no() { printf '  \033[33m•\033[0m %s\n' "$1"; }

echo "Omakid drift check — $(hostname), $(date '+%Y-%m-%d %H:%M')"
[[ -r /etc/chromium/policies/managed/omakid.json ]] && ok "Chromium policy" || no "Chromium policy missing"
systemctl is-enabled --quiet omakid-curfew.timer && ok "16:00–20:00 curfew timer" || no "curfew timer disabled"
systemctl is-active --quiet NetworkManager && ok "network manager" || no "NetworkManager down"
omakid-shell ping >/dev/null 2>&1 && ok "launcher responding" || no "LAUNCHER DOWN"
wpctl status 2>/dev/null | grep -q 'Sinks:' && ok "audio" || no "NO AUDIO"
