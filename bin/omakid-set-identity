#!/usr/bin/env bash
set -euo pipefail
state="${XDG_STATE_HOME:-$HOME/.local/state}/omakid"
mkdir -p "$state"

case "${1:-}" in
  colour)
    case "${2:-}" in pink-light|blue-light|pink-bright|blue-bright|purple|gold) ;; *) echo "unknown Omakid colour" >&2; exit 2 ;; esac
    printf '%s\n' "$2" > "$state/colour"
    OMARCHY_THEME_HEADLESS=1 omarchy-theme-set "omakid-$2"
    ;;
  avatar)
    case "${2:-}" in orca|elephant|bunny|jellyfish|panther|bear) ;; *) echo "unknown Omakid avatar" >&2; exit 2 ;; esac
    printf '%s\n' "$2" > "$state/avatar"
    ;;
  name)
    name=${2:-}
    [[ -n "$name" ]] || { echo "name must not be empty" >&2; exit 2; }
    printf '%s\n' "$name" > "$state/name"
    mkdir -p "$HOME/.config/omarchy/branding"
    if command -v figlet >/dev/null; then
      figlet -f big "$name" > "$HOME/.config/omarchy/branding/screensaver.txt"
    else
      printf '%s\n' "$name" > "$HOME/.config/omarchy/branding/screensaver.txt"
    fi
    ;;
  *)
    echo "usage: omakid-set-identity colour|avatar|name value" >&2
    exit 2
    ;;
esac
