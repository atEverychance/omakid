#!/usr/bin/env bash
# Idempotent package-state repair; package files remain the source of truth.
set -euo pipefail
(( EUID == 0 )) || { echo "omakid-apply must run as root" >&2; exit 1; }
[[ -r /usr/share/omarchy/shell/omakid/shell.qml ]] || { echo "Omakid package payload is missing" >&2; exit 1; }
systemctl daemon-reload
systemctl enable --now systemd-resolved.service NetworkManager.service power-profiles-daemon.service systemd-oomd.service omakid-curfew.timer
systemctl enable sddm.service
systemctl disable --now cups.service avahi-daemon.service docker.socket 2>/dev/null || true
printf 'Omakid package state applied. User config remains package-owned through /etc/skel.\n'
