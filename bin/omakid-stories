#!/usr/bin/env bash
set -euo pipefail
root=${OMAKID_STORIES_ROOT:-/usr/share/omarchy/shell/omakid/content/stories/www.storybookscanada.ca}
[[ -s "$root/index.html" ]] || { echo "Offline Storybooks mirror missing: $root/index.html" >&2; exit 1; }
if ! curl -fsS -o /dev/null http://127.0.0.1:8080/; then
  python3 -m http.server 8080 --directory "$root" >/dev/null 2>&1 &
  for _ in 1 2 3 4 5; do
    curl -fsS -o /dev/null http://127.0.0.1:8080/ && break
    sleep 0.2
  done
fi
curl -fsS -o /dev/null http://127.0.0.1:8080/ || { echo "Offline Storybooks server failed to start" >&2; exit 1; }
exec chromium --kiosk --no-first-run --disable-features=TranslateUI http://127.0.0.1:8080/
