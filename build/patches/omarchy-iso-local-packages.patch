diff --git a/builder/build-omarchy-packages.sh b/builder/build-omarchy-packages.sh
index 5f7173f..56d12ec 100755
--- a/builder/build-omarchy-packages.sh
+++ b/builder/build-omarchy-packages.sh
@@ -39,9 +39,29 @@ pacman -Sy --noconfirm
 packages=(
   "$OMARCHY_SETTINGS_PACKAGE"
   "$OMARCHY_RUNTIME_PACKAGE"
-  "$OMARCHY_NVIM_PACKAGE"
+  sdl2_pango
+  tuxpaint
 )

+find_exact_package() {
+  local package_name=$1 directory=$2 candidate candidate_name found=
+  for candidate in "$directory"/*.pkg.tar.*; do
+    [[ -f $candidate && $candidate != *.sig ]] || continue
+    read -r candidate_name _ < <(pacman -Qp "$candidate" 2>/dev/null) || continue
+    [[ $candidate_name == "$package_name" ]] || continue
+    if [[ -n $found ]]; then
+      echo "ERROR: multiple builds found for $package_name in $directory" >&2
+      return 1
+    fi
+    found=$candidate
+  done
+  if [[ -z $found ]]; then
+    echo "ERROR: build not found for $package_name in $directory" >&2
+    return 1
+  fi
+  printf '%s\n' "$found"
+}
+
 # Local-source packages must replace every cached build of the same package,
 # even when the checkout's generated pkgver sorts below a published build.
 # Otherwise the later generic cache pruning can silently keep edge instead.
@@ -65,8 +85,15 @@ for pkg in "${packages[@]}"; do
     cd '$pkg_work' &&
     PKGDEST='$work_dir' \
     OMARCHY_SRC=/omarchy-source \
-    makepkg --noconfirm --skippgpcheck --skipchecksums --nodeps -f
+    makepkg --noconfirm --syncdeps --needed --skippgpcheck -f
   "
+
+  # Tux Paint's sdl2_pango dependency is local too. Install the exact artifact
+  # into this package-build container before makepkg resolves Tux Paint.
+  if [[ $pkg == sdl2_pango ]]; then
+    sdl2_pango_package=$(find_exact_package sdl2_pango "$work_dir")
+    pacman -U --noconfirm "$sdl2_pango_package"
+  fi
 done

 mkdir -p "$offline_mirror_dir"
@@ -82,4 +109,6 @@ done

 echo
 echo "Built Omarchy packages, placed in $offline_mirror_dir:"
-ls "$offline_mirror_dir"/omarchy*.pkg.tar.zst | sed 's|^|  |'
+for pkg in "${packages[@]}"; do
+  find_exact_package "$pkg" "$offline_mirror_dir"
+done | sed 's|^|  |'
