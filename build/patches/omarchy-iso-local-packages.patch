+# Every package built from the mounted source trees. Keep this one list as the
+# source of truth for online filtering and exact offline-artifact retention.
+local_package_names=(
+  "$OMARCHY_RUNTIME_PACKAGE"
+  "$OMARCHY_SETTINGS_PACKAGE"
+  sdl2_pango
+  tuxpaint
+)
+
+find_exact_package() {
+  local package_name=$1 directory=$2 candidate candidate_metadata candidate_name found=
+  for candidate in "$directory/$package_name-"*.pkg.tar.*; do
+    [[ -f $candidate && $candidate != *.sig ]] || continue
+    if ! candidate_metadata=$(pacman -Qp "$candidate" 2>/dev/null) ||
+      ! read -r candidate_name _ <<< "$candidate_metadata"; then
+      echo "ERROR: cannot read package metadata from $candidate" >&2
+      return 1
+    fi
+    [[ $candidate_name == "$package_name" ]] || continue
+    if [[ -n $found ]]; then
+      echo "ERROR: multiple builds found for $package_name in $directory" >&2
+      return 1
+    fi
+    found=$candidate
+  done
+  if [[ -z $found ]]; then
+    echo "ERROR: build not found for $package_name in $directory" >&2
+    return 1
+  fi
+  printf '%s\n' "$found"
+}
+
+normalize_dependency_target() {
+  local dependency=$1 target constraint
+  local package_name_pattern='^[[:alnum:]@._+-]+$'
+  local constraint_pattern='^(>=|<=|=|>|<)[^[:space:]<>=]+$'
+
+  target=${dependency%%[<>=]*}
+  constraint=${dependency#"$target"}
+  if [[ ! $target =~ $package_name_pattern ]] ||
+    { [[ -n $constraint ]] && [[ ! $constraint =~ $constraint_pattern ]]; }; then
+    return 1
+  fi
+  printf '%s\n' "$target"
+}
+
+read_runtime_dependencies() {
+  local package_name=$1 package_file=$2 pkginfo line dependency target
+  local metadata_name=
+
+  if ! pkginfo=$(bsdtar -xOf "$package_file" .PKGINFO 2>/dev/null); then
+    echo "ERROR: cannot read .PKGINFO from local build $package_file" >&2
+    return 1
+  fi
+  while IFS= read -r line; do
+    case "$line" in
+      "pkgname = "*)
+        if [[ -n $metadata_name ]]; then
+          echo "ERROR: duplicate pkgname metadata in local build $package_file" >&2
+          return 1
+        fi
+        metadata_name=${line#pkgname = }
+        ;;
+      "depend = "*)
+        dependency=${line#depend = }
+        if ! target=$(normalize_dependency_target "$dependency"); then
+          echo "ERROR: malformed runtime dependency '$dependency' in $package_file" >&2
+          return 1
+        fi
+        printf '%s\n' "$target"
+        ;;
+      depend*)
+        echo "ERROR: malformed dependency metadata '$line' in $package_file" >&2
+        return 1
+        ;;
+    esac
+  done <<< "$pkginfo"
+  if [[ $metadata_name != "$package_name" ]]; then
+    echo "ERROR: expected pkgname $package_name in $package_file, found '${metadata_name:-missing}'" >&2
+    return 1
+  fi
+}
+
