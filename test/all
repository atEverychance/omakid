    "test -s '$prepared_omarchy/install/provisioning/setup-form.sh' && cmp -s install/omakid-base.packages '$prepared_omarchy/install/omarchy-base.packages' && cmp -s install/hardware/all.sh '$prepared_omarchy/install/hardware/all.sh'"
  check "prepared local dependency chain and offline artifacts contract" python3 - "$prepared_pkgs" "$prepared_iso" <<'PY'
import re
import sys
from pathlib import Path

source_packages = Path('packages')
prepared_packages = Path(sys.argv[1]) / 'pkgbuilds'
iso = Path(sys.argv[2])

for name in ('sdl2_pango', 'tuxpaint'):
    source = source_packages / name
    prepared = prepared_packages / name
    source_files = {path.relative_to(source) for path in source.rglob('*') if path.is_file()}
    prepared_files = {path.relative_to(prepared) for path in prepared.rglob('*') if path.is_file()}
    if source_files != prepared_files:
        raise SystemExit(f'{name} overlay file set differs: {source_files ^ prepared_files}')
    for relative in source_files:
        if (source / relative).read_bytes() != (prepared / relative).read_bytes():
            raise SystemExit(f'{name} overlay content differs: {relative}')

builder = (iso / 'builder/build-omarchy-packages.sh').read_text()
match = re.search(r'packages=\(\n(?P<body>.*?)\n\)', builder, re.S)
order = [line.strip().strip('"') for line in match.group('body').splitlines() if line.strip()] if match else []
if order != ['$OMARCHY_SETTINGS_PACKAGE', '$OMARCHY_RUNTIME_PACKAGE', 'sdl2_pango', 'tuxpaint']:
    raise SystemExit(f'prepared build order is unsafe: {order}')
makepkg = builder.index('makepkg --noconfirm --syncdeps --needed --skippgpcheck -f')
handoff = builder.index('if [[ $pkg == sdl2_pango ]]; then', makepkg)
install = builder.index('pacman -U --noconfirm "$sdl2_pango_package"', handoff)
loop_end = builder.index('\ndone', install)
if not makepkg < handoff < install < loop_end:
    raise SystemExit('prepared builder lacks the pre-Tux-Paint local install handoff')
if 'sdl2_pango_package=$(find_exact_package sdl2_pango "$work_dir")' not in builder:
    raise SystemExit('prepared builder does not select the exact sdl2_pango artifact')

build_iso = (iso / 'builder/build-iso.sh').read_text()
match = re.search(r'local_package_names=\(\n(?P<body>.*?)\n\)', build_iso, re.S)
keep_set = [line.strip().strip('"') for line in match.group('body').splitlines() if line.strip()] if match else []
if keep_set != ['$OMARCHY_RUNTIME_PACKAGE', '$OMARCHY_SETTINGS_PACKAGE', 'sdl2_pango', 'tuxpaint']:
    raise SystemExit(f'prepared offline keep-set drifted: {keep_set}')
for function in ('find_exact_package', 'normalize_dependency_target', 'read_runtime_dependencies'):
    if not re.search(rf'(?m)^{function}\(\) \{{$', build_iso):
        raise SystemExit(f'prepared ISO builder lacks helper: {function}')
for invariant in (
    'pacman -Qp "$candidate"', 'cannot read package metadata',
    'bsdtar -xOf "$package_file" .PKGINFO', 'cannot read .PKGINFO',
    'malformed runtime dependency',
):
    if invariant not in build_iso:
        raise SystemExit(f'prepared local metadata fail-closed invariant missing: {invariant}')

discover = build_iso.index('for local_package_name in "${local_package_names[@]}"; do')
metadata = build_iso.index(
    'read_runtime_dependencies "$local_package_name" "$local_package_file"', discover
)
collect = build_iso.index('# Collect every package we want available in the offline mirror.', metadata)
seed = build_iso.index('all_packages+=("${local_dependency_targets[@]}")', collect)
filter_names = build_iso.index(
    'grep -Fxv -f <(printf \'%s\\n\' "${local_package_names[@]}")', seed
)
download = build_iso.index('download_offline_packages()', filter_names)
if not discover < metadata < collect < seed < filter_names < download:
    raise SystemExit('prepared builder does not derive and seed local runtime dependencies before filtering')

resolve = build_iso.index('if ! resolved_package_files=', download)
retain = build_iso.index('for local_package_file in "${local_package_files[@]}"; do', resolve)
append = build_iso.index('required_package_files+=("${local_package_file##*/}")', retain)
if not resolve < retain < append:
    raise SystemExit('prepared builder does not retain exact local artifacts in discovery order')
if build_iso.count('find_exact_package "$local_package_name" "$offline_mirror_dir"') != 1:
    raise SystemExit('prepared builder repeats exact local artifact discovery unsafely')
PY
  check "prepared child session autologins without requiring encryption" sh -c \
    "grep -q 'if not ctx.defer_provisioning:' '$prepared_iso/configs/airootfs/usr/share/omarchy-iso/orchestrator/phases_impl.py' && grep -q \"Omakid.s child session is passwordless\" '$prepared_iso/configs/airootfs/usr/share/omarchy-iso/orchestrator/phases_impl.py' && ! grep -q 'if ctx.encrypt and not ctx.defer_provisioning:' '$prepared_iso/configs/airootfs/usr/share/omarchy-iso/orchestrator/phases_impl.py'"
  if [[ -d $prepared_omarchy/shell/omakid/content ]]; then
    check "prepared offline content contract" sh -c \
      "test -s '$prepared_omarchy/shell/omakid/content/stories/www.storybookscanada.ca/index.html' && test \"\$(find '$prepared_omarchy/shell/omakid/content/gcompris/voices-ogg' -name 'voices-*.rcc' | wc -l)\" -ge 2"
  fi
fi

if (( failures )); then
  printf '%s test(s) failed.\n' "$failures" >&2
  exit 1
fi
printf 'All Omakid overlay tests passed.\n'
