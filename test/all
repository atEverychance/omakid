check "ISO patch derives local runtime closure before online filtering" python3 - <<'PY'
import re
from pathlib import Path

patch = Path('build/patches/omarchy-iso-local-packages.patch').read_text()
iso_start = patch.index('diff --git a/builder/build-iso.sh')
builder_start = patch.index('diff --git a/builder/build-omarchy-packages.sh')
phases_start = patch.index('diff --git a/configs/', builder_start)
iso_diff = patch[iso_start:builder_start]
builder_diff = patch[builder_start:phases_start]

# Read the effective lines represented by each diff hunk, excluding removals
# and patch headers. This validates control/data flow, not package-name mentions.
def effective(diff):
    lines = []
    for line in diff.splitlines():
        if line.startswith(('---', '+++', 'diff ', 'index ', '@@')) or line.startswith('-'):
            continue
        lines.append(line[1:] if line.startswith(('+', ' ')) else line)
    return '\n'.join(lines)

builder = effective(builder_diff)
match = re.search(r'packages=\(\n(?P<body>.*?)\n\)', builder, re.S)
if not match:
    raise SystemExit('package build-order array is missing')
order = [line.strip().strip('"') for line in match.group('body').splitlines() if line.strip()]
if order != ['$OMARCHY_SETTINGS_PACKAGE', '$OMARCHY_RUNTIME_PACKAGE', 'sdl2_pango', 'tuxpaint']:
    raise SystemExit(f'unsafe local package build order: {order}')
makepkg = builder.index('makepkg --noconfirm --syncdeps --needed --skippgpcheck -f')
handoff = builder.index('if [[ $pkg == sdl2_pango ]]; then', makepkg)
install = builder.index('pacman -U --noconfirm "$sdl2_pango_package"', handoff)
loop_end = builder.index('\ndone', install)
if not makepkg < handoff < install < loop_end:
    raise SystemExit('sdl2_pango is not installed immediately after its build and before Tux Paint')
if 'sdl2_pango_package=$(find_exact_package sdl2_pango "$work_dir")' not in builder:
    raise SystemExit('local dependency handoff does not identify the exact built package')
for invariant in (
    'pacman -Qp "$candidate"', 'cannot read package metadata',
    'multiple builds found', 'build not found',
):
    if invariant not in builder:
        raise SystemExit(f'exact local artifact validation missing: {invariant}')

iso = effective(iso_diff)
match = re.search(r'local_package_names=\(\n(?P<body>.*?)\n\)', iso, re.S)
if not match:
    raise SystemExit('local offline package keep-set is missing')
keep_set = [line.strip().strip('"') for line in match.group('body').splitlines() if line.strip()]
if keep_set != ['$OMARCHY_RUNTIME_PACKAGE', '$OMARCHY_SETTINGS_PACKAGE', 'sdl2_pango', 'tuxpaint']:
    raise SystemExit(f'local package keep-set drifted: {keep_set}')

for function in ('find_exact_package', 'normalize_dependency_target', 'read_runtime_dependencies'):
    if not re.search(rf'(?m)^{function}\(\) \{{$', iso):
        raise SystemExit(f'missing local metadata helper: {function}')
for invariant in (
    'bsdtar -xOf "$package_file" .PKGINFO',
    'dependency=${line#depend = }',
    'target=$(normalize_dependency_target "$dependency")',
    'cannot read .PKGINFO',
    'malformed runtime dependency',
):
    if invariant not in iso:
        raise SystemExit(f'local runtime metadata contract missing: {invariant}')

discover = iso.index('for local_package_name in "${local_package_names[@]}"; do')
exact = iso.index('local_package_file=$(find_exact_package', discover)
metadata = iso.index('read_runtime_dependencies "$local_package_name" "$local_package_file"', exact)
seed = iso.index('all_packages+=("${local_dependency_targets[@]}")', metadata)
filter_names = iso.index('grep -Fxv -f <(printf \'%s\\n\' "${local_package_names[@]}")', seed)
retain = iso.index('for local_package_file in "${local_package_files[@]}"; do', filter_names)
append = iso.index('required_package_files+=("${local_package_file##*/}")', retain)
if not discover < exact < metadata < seed < filter_names < retain < append:
    raise SystemExit(
        'local metadata is not seeded before filtering, or exact artifacts are not retained in order'
    )
if iso.count('find_exact_package "$local_package_name" "$offline_mirror_dir"') != 1:
    raise SystemExit('exact artifact lookup should be reused, not repeated after online resolution')
PY

